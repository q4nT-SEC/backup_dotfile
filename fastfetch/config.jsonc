{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "kali",
    "type": "auto"
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    {
      "type": "packages",
      "format": "{pacman} (pacman), {flatpak-system} (flatpak), {appimage} (appimage)"
    },
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "cursor",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "break",
    "colors"
  ]
}
